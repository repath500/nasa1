{
  "name": "fire-atlas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @fire/web dev",
    "dev:server": "pnpm --filter @fire/server dev",
    "build": "pnpm corpus && pnpm --filter @fire/web build",
    "corpus": "pnpm --filter @fire/pipeline build:corpus",
    "audio:build": "pnpm --filter @fire/server audio:build",
    "ai:publish": "pnpm --filter @fire/server ai:publish",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "e2e": "pnpm --filter @fire/web e2e",
    "lint:claims": "node scripts/lint-claims.mjs",
    "secret-scan": "sh scripts/secret-scan.sh",
    "review": "pnpm --filter @fire/pipeline review",
    "review:sign": "pnpm --filter @fire/pipeline review:sign"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "~2.1.5",
    "@types/node": "~22.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
